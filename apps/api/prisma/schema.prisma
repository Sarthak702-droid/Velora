datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PLATFORM_ADMIN
  SALON_OWNER
  BRANCH_MANAGER
  RECEPTIONIST
  PROFESSIONAL
}

enum OperationalStatus {
  AVAILABLE
  BUSY
  BREAK
  OFFLINE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  WAITING
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CALLED
  CHECKED_IN
  IN_SERVICE
  COMPLETED
  SKIPPED
  CANCELLED
  LEFT
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum GenderApplicability {
  MALE
  FEMALE
  UNISEX
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Tenant {
  id                      String                  @id @default(cuid())
  slug                    String                  @unique
  name                    String
  status                  String                  @default("ACTIVE")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  salonProfile            SalonProfile?
  subscriptions           Subscription[]
  featureOverrides        TenantFeatureOverride[]
  branches                Branch[]
  users                   User[]
  staffProfiles           StaffProfile[]
  serviceCategories       ServiceCategory[]
  services                Service[]
  customers               Customer[]
  appointments            Appointment[]
  queues                  Queue[]
  queueEntries            QueueEntry[]
  notifications           Notification[]
  payments                Payment[]
  auditLogs               AuditLog[]
  dailyMetrics            DailyMetric[]
  hourlyMetrics           HourlyMetric[]

  @@index([slug])
  @@index([status])
}

model SalonProfile {
  id                      String                  @id @default(cuid())
  tenantId                String                  @unique
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tagline                 String?
  logoUrl                 String?
  coverUrl                String?
  about                   String?
  gstNumber               String?
  currency                String                  @default("INR")
  timezone                String                  @default("Asia/Kolkata")
  socialLinks             Json?
  cancellationWindowHours Int                     @default(2)
  depositType             String                  @default("NONE") // NONE, FLAT, PERCENTAGE
  depositAmount           Float                   @default(0)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model Branch {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug                    String
  name                    String
  address                 String
  city                    String
  state                   String
  pincode                 String
  phone                   String
  whatsapp                String?
  email                   String?
  openingTime             String                  @default("09:00")
  closingTime             String                  @default("21:00")
  weeklyHolidays          String[]                @default(["SUNDAY"])
  timezone                String                  @default("Asia/Kolkata")
  currency                String                  @default("INR")
  active                  Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  users                   User[]
  staffSchedules          StaffSchedule[]
  appointments            Appointment[]
  queue                   Queue?
  queueEntries            QueueEntry[]
  auditLogs               AuditLog[]
  dailyMetrics            DailyMetric[]
  hourlyMetrics           HourlyMetric[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Plan {
  id                      String                  @id @default(cuid())
  code                    String                  @unique // START, FLOW, PRO, MULTI
  name                    String
  description             String
  monthlyPrice            Int
  setupPrice              Int
  annualPrice             Int
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  planFeatures            PlanFeature[]
  subscriptions           Subscription[]
}

model Feature {
  id                      String                  @id @default(cuid())
  key                     String                  @unique // core.base, book.advance, queue.live, flow.unified, etc.
  name                    String
  description             String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  planFeatures            PlanFeature[]
  overrides               TenantFeatureOverride[]
}

model PlanFeature {
  id                      String                  @id @default(cuid())
  planId                  String
  plan                    Plan                    @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId               String
  feature                 Feature                 @relation(fields: [featureId], references: [id], onDelete: Cascade)
  enabled                 Boolean                 @default(true)

  @@unique([planId, featureId])
}

model Subscription {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId                  String
  plan                    Plan                    @relation(fields: [planId], references: [id])
  status                  SubscriptionStatus      @default(ACTIVE)
  currentPeriodStart      DateTime                @default(now())
  currentPeriodEnd        DateTime
  cancelAtPeriodEnd       Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([tenantId])
}

model TenantFeatureOverride {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureId               String
  feature                 Feature                 @relation(fields: [featureId], references: [id], onDelete: Cascade)
  enabled                 Boolean
  reason                  String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([tenantId, featureId])
  @@index([tenantId])
}

model User {
  id                      String                  @id @default(cuid())
  tenantId                String?
  tenant                  Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId                String?
  branch                  Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  email                   String                  @unique
  passwordHash            String
  name                    String
  phone                   String?
  role                    UserRole
  mfaEnabled              Boolean                 @default(false)
  mfaSecret               String?
  active                  Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  staffProfile            StaffProfile?
  auditLogs               AuditLog[]

  @@index([tenantId])
  @@index([role])
}

model StaffProfile {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                  String?                 @unique
  user                    User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                    String
  phone                   String?
  email                   String?
  photoUrl                String?
  title                   String                  @default("Stylist")
  operationalStatus       OperationalStatus       @default(AVAILABLE)
  rating                  Float                   @default(4.9)
  reviewCount             Int                     @default(0)
  active                  Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  services                StaffService[]
  schedules               StaffSchedule[]
  breaks                  StaffBreak[]
  appointments            Appointment[]
  queueEntries            QueueEntry[]

  @@index([tenantId])
  @@index([operationalStatus])
}

model ServiceCategory {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                    String
  slug                    String
  displayOrder            Int                     @default(0)
  active                  Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  services                Service[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Service {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId              String
  category                ServiceCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                    String
  slug                    String
  description             String?
  price                   Float
  duration                Int                     // minutes
  buffer                  Int                     @default(5) // minutes
  gender                  GenderApplicability     @default(UNISEX)
  imageUrl                String?
  active                  Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  staff                   StaffService[]
  appointmentServices     AppointmentService[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([categoryId])
}

model StaffService {
  id                      String                  @id @default(cuid())
  staffId                 String
  staff                   StaffProfile            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId               String
  service                 Service                 @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
}

model StaffSchedule {
  id                      String                  @id @default(cuid())
  staffId                 String
  staff                   StaffProfile            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branchId                String
  branch                  Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dayOfWeek               Int                     // 0 = Sunday, 1 = Monday ... 6 = Saturday
  startTime               String                  @default("09:00")
  endTime                 String                  @default("20:00")
  isWorkingDay            Boolean                 @default(true)

  @@unique([staffId, branchId, dayOfWeek])
  @@index([staffId])
  @@index([branchId])
}

model StaffBreak {
  id                      String                  @id @default(cuid())
  staffId                 String
  staff                   StaffProfile            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startTime               String                  // e.g. "13:30"
  endTime                 String                  // e.g. "14:30"
  label                   String?                 @default("Break")
  dayOfWeek               Int?

  @@index([staffId])
}

model Customer {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                    String
  phone                   String
  email                   String?
  notes                   String?
  preferredStaffId        String?
  totalVisits             Int                     @default(0)
  lastVisitAt             DateTime?
  marketingConsent        Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  appointments            Appointment[]
  queueEntries            QueueEntry[]
  notifications           Notification[]
  payments                Payment[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([phone])
}

model Appointment {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId                String
  branch                  Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId              String
  customer                Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId                 String?
  staff                   StaffProfile?           @relation(fields: [staffId], references: [id], onDelete: SetNull)
  date                    DateTime                @db.Date
  startTime               DateTime
  endTime                 DateTime
  totalDuration           Int                     // minutes
  totalBuffer             Int                     @default(5) // minutes
  totalPrice              Float
  status                  AppointmentStatus       @default(CONFIRMED)
  checkInAt               DateTime?
  serviceStartAt          DateTime?
  serviceCompleteAt       DateTime?
  cancellationReason      String?
  notes                   String?
  rescheduledFromId       String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  services                AppointmentService[]
  history                 AppointmentHistory[]
  queueEntry              QueueEntry?
  payment                 Payment?

  @@index([tenantId, branchId, date])
  @@index([staffId, date])
  @@index([status])
}

model AppointmentService {
  id                      String                  @id @default(cuid())
  appointmentId           String
  appointment             Appointment             @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId               String
  service                 Service                 @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  price                   Float
  duration                Int
  buffer                  Int

  @@index([appointmentId])
  @@index([serviceId])
}

model AppointmentHistory {
  id                      String                  @id @default(cuid())
  appointmentId           String
  appointment             Appointment             @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromStatus              AppointmentStatus?
  toStatus                AppointmentStatus
  actorId                 String?
  actorRole               String?
  reason                  String?
  timestamp               DateTime                @default(now())

  @@index([appointmentId])
}

model Queue {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId                String                  @unique
  branch                  Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  currentSequence         Int                     @default(0)
  prefix                  String                  @default("V")
  active                  Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  entries                 QueueEntry[]

  @@index([tenantId])
}

model QueueEntry {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId                String
  branch                  Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  queueId                 String
  queue                   Queue                   @relation(fields: [queueId], references: [id], onDelete: Cascade)
  customerId              String
  customer                Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId                 String?
  staff                   StaffProfile?           @relation(fields: [staffId], references: [id], onDelete: SetNull)
  appointmentId           String?                 @unique
  appointment             Appointment?            @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  tokenNumber             String                  // e.g. V018
  displayNumber           Int                     // 18
  serviceIds              String[]
  totalDuration           Int
  totalBuffer             Int                     @default(5)
  status                  QueueStatus             @default(WAITING)
  position                Int
  estimatedWaitMinutes    Int                     @default(0)
  estimatedStartTime      DateTime?
  checkInAt               DateTime?
  calledAt                DateTime?
  serviceStartAt          DateTime?
  completedAt             DateTime?
  joinedAt                DateTime                @default(now())
  notes                   String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  history                 QueueHistory[]

  @@index([tenantId, branchId, status])
  @@index([queueId, position])
  @@index([staffId])
}

model QueueHistory {
  id                      String                  @id @default(cuid())
  queueEntryId            String
  queueEntry              QueueEntry              @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  fromPosition            Int?
  toPosition              Int?
  fromStatus              QueueStatus?
  toStatus                QueueStatus?
  actorId                 String?
  actorName               String?
  actorRole               String?
  reason                  String?
  timestamp               DateTime                @default(now())

  @@index([queueEntryId])
}

model Notification {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId              String?
  customer                Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channel                 String                  // WHATSAPP, SMS, EMAIL
  recipient               String                  // phone or email
  templateKey             String                  // BOOKING_CONFIRMED, QUEUE_JOINED, etc.
  content                 String
  status                  String                  @default("PENDING") // PENDING, SENT, DELIVERED, FAILED
  externalId              String?
  sentAt                  DateTime?
  createdAt               DateTime                @default(now())

  @@index([tenantId])
  @@index([status])
}

model Payment {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId           String?                 @unique
  appointment             Appointment?            @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  customerId              String
  customer                Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount                  Float
  currency                String                  @default("INR")
  status                  PaymentStatus           @default(NOT_REQUIRED)
  purpose                 String                  @default("DEPOSIT")
  premiumExpiresAt        DateTime?
  premiumProfile          Json?
  provider                String                  @default("RAZORPAY")
  orderId                 String?
  paymentId               String?
  signature               String?
  idempotencyKey          String?                 @unique
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([tenantId])
  @@index([orderId])
}

model AuditLog {
  id                      String                  @id @default(cuid())
  tenantId                String?
  tenant                  Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId                String?
  branch                  Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actorId                 String?
  actorName               String?
  actorRole               String?
  action                  String                  // QUEUE_POSITION_CHANGED, SERVICE_STARTED, etc.
  entityType              String                  // QueueEntry, Appointment, etc.
  entityId                String
  before                  Json?
  after                   Json?
  reason                  String?
  ipAddress               String?
  userAgent               String?
  requestId               String?
  timestamp               DateTime                @default(now())

  user                    User?                   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, action])
  @@index([entityType, entityId])
  @@index([timestamp])
}

model DailyMetric {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId                String
  branch                  Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date                    DateTime                @db.Date
  totalCustomers          Int                     @default(0)
  appointmentsCount       Int                     @default(0)
  walkinsCount            Int                     @default(0)
  completedCount          Int                     @default(0)
  noShowCount             Int                     @default(0)
  cancelledCount          Int                     @default(0)
  avgWaitMinutes          Float                   @default(0)
  avgServiceMinutes       Float                   @default(0)
  peakHour                Int?
  mostBookedService       String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([tenantId, branchId, date])
  @@index([tenantId, date])
}

model HourlyMetric {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId                String
  branch                  Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date                    DateTime                @db.Date
  hour                    Int                     // 0..23
  activeVisits            Int                     @default(0)
  avgWaitMinutes          Float                   @default(0)

  @@unique([tenantId, branchId, date, hour])
  @@index([tenantId, date])
}

model SecurityOtp {
  id                      String                  @id @default(cuid())
  phone                   String
  tokenHash               String
  attempts                Int                     @default(0)
  expiresAt               DateTime
  consumed                Boolean                 @default(false)
  ipAddress               String?
  createdAt               DateTime                @default(now())

  @@index([phone, consumed])
  @@index([expiresAt])
}

model IdempotencyRecord {
  id                      String                  @id @default(cuid())
  key                     String                  @unique
  method                  String
  path                    String
  statusCode              Int
  responseBody            Json
  createdAt               DateTime                @default(now())
  expiresAt               DateTime

  @@index([key])
  @@index([expiresAt])
}
