# Velora API Configuration Template
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Database - PostgreSQL (Stable version 16/18)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velora?schema=public"

# Redis (Ephemeral state, distributed locks, BullMQ)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="replace_with_a_secure_random_64_character_string_for_production"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="replace_with_a_secure_cookie_secret_for_production"
ENCRYPTION_KEY="replace_with_32_byte_aes_gcm_secret_key"

# CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Rate Limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Payments (Razorpay)
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
RAZORPAY_KEY_SECRET="xxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxx"

# Communications (WhatsApp Cloud API & Resend Email)
WHATSAPP_TOKEN="xxxxxx"
WHATSAPP_PHONE_NUMBER_ID="xxxxxx"
RESEND_API_KEY="re_xxxxxx"
FROM_EMAIL="notifications@velora.com"
