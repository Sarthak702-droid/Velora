# Server-only URL. Include host and port; do not append /api/v1.
API_UPSTREAM_URL=http://127.0.0.1:4000
# Public salon slug. Actual tenant and branch IDs are fetched from the API.
NEXT_PUBLIC_SALON_SLUG=velora-signature
# Live is the default. Set demo only for the original synthetic visual fixture.
NEXT_PUBLIC_DATA_MODE=live
# Set to the exact HTTPS frontend origin behind a reverse proxy in production.
# WEB_ORIGIN=https://your-salon.example.com
